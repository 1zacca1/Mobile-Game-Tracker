# Postgres connection string (Neon / Vercel Postgres). Use the POOLED url.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Secret that protects /api/collect. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" when this env var exists on the project.
# Generate one: openssl rand -hex 32
CRON_SECRET=

# REQUIRED in production: the key that authorizes every change (add/edit/delete
# games, import, collect, setup, calibration). The site and Admin page stay
# viewable by anyone; without this key nothing can be modified. The Admin page
# has a field for it (stored only in your browser); scripts send it as an
# x-admin-token header. If unset, all changes are refused in production.
# Generate one: openssl rand -hex 24
ADMIN_TOKEN=

# Meta Ad Library API token (optional — the meta job is skipped without it).
# See README "Meta token setup".
META_AD_LIBRARY_TOKEN=
