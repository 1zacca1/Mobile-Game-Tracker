# Postgres connection string (Neon / Vercel Postgres). Use the POOLED url.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Secret that protects /api/collect. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" when this env var exists on the project.
# Generate one: openssl rand -hex 32
CRON_SECRET=

# REQUIRED in production: password for the whole Admin area (/admin and
# /api/admin/*). The browser asks for it (any username, this as the password);
# scripts can send it as an x-admin-token header. If unset, admin is disabled.
# Generate one: openssl rand -hex 24
ADMIN_TOKEN=

# Meta Ad Library API token (optional — the meta job is skipped without it).
# See README "Meta token setup".
META_AD_LIBRARY_TOKEN=
