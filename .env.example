# Postgres connection string (Neon / Vercel Postgres). Use the POOLED url.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Secret that protects /api/collect. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" when this env var exists on the project.
# Generate one: openssl rand -hex 32
CRON_SECRET=

# Optional but recommended once the URL is public: required (x-admin-token
# header) for all admin mutations; the Admin page stores it in localStorage.
ADMIN_TOKEN=

# Meta Ad Library API token (optional — the meta job is skipped without it).
# See README "Meta token setup".
META_AD_LIBRARY_TOKEN=
